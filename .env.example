# Port panelu na hoście
APP_PORT=8080

# Strefa IANA używana domyślnie przez harmonogram
TZ=Europe/Warsaw

# Maksymalny rozmiar pojedynczego pliku
MAX_UPLOAD_MB=25

# Ustaw obie wartości, aby włączyć formularz logowania i podpisaną sesję cookie.
# Użyj długiego, losowego hasła i nigdy nie publikuj właściwego pliku .env.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=zmien-to-haslo-przed-uruchomieniem

LOG_LEVEL=INFO

# Włącz tylko za zaufanym reverse proxy, które nadpisuje nagłówki Forwarded/X-Forwarded-*.
TRUST_PROXY_HEADERS=false

# Ustaw true tylko wtedy, gdy panel jest dostępny wyłącznie przez HTTPS.
SESSION_COOKIE_SECURE=false
